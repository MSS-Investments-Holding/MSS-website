# ─────────────────────────────────────────────
# MSS Investments Holding — Environment Variables
# Copy this file to .env.local and fill in values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────

# Sanity CMS
# Project ID and dataset are found in sanity.io/manage under your project settings.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# API token with read permissions — generated in sanity.io/manage > API > Tokens.
SANITY_API_TOKEN=

# Supabase
# Project URL and keys are found in supabase.com/dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# Anon/public key — the pitch form inserts with this key under an
# insert-only RLS policy (supabase/migrations/002).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional fallback, only needed until migration 002 is applied.
# Bypasses row-level security — keep it server-side only, then remove it.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email for the Pitch to Us form)
# API key is generated at resend.com/api-keys.
RESEND_API_KEY=
# The "from" address must be a verified domain in your Resend account.
PITCH_FORM_FROM_EMAIL=MSS Website <noreply@yourdomain.com>
# The internal address that receives pitch form submission notifications.
PITCH_FORM_TO_EMAIL=
