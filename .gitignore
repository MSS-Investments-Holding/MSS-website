# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Claude Code and IDE settings (may contain API tokens)
.claude/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is intentionally committed as a template
.env*
!.env.example

# Internal agency working files — kept locally, not shipped to client
CLAUDE.md
docs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
